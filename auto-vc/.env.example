# ==============================================================================
# Auto-VC Environment Configuration Example
# ==============================================================================
# Copy this file to .env or point environmentFile in NixOS to this configuration.

# Target Git repository directory to track and sync
REPO_PATH="/home/kryisnn/.config/flint"

# Git branch to commit and push changes to
GIT_BRANCH="main"

# Remote repository name
GIT_REMOTE="origin"

# Frequency of repository checks in seconds (e.g., 60 = 1 minute, 300 = 5 minutes)
CHECK_INTERVAL="60"

# Conventional commit message prefix
COMMIT_PREFIX="chore(auto-vc)"

# Pull with rebase before pushing to avoid non-fast-forward rejections
PULL_BEFORE_PUSH="true"

# Dedicated SSH private key for GitHub authentication
SSH_KEY="/home/kryisnn/.ssh/id_github_deploy"

# Optional path to log file (leave empty to log to systemd journal)
LOG_FILE=""

# Dry-run mode: set to "true" to test change detection without committing or pushing
DRY_RUN="false"
