# ==============================================================================
# Photo Gallery (Life Museum) Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Immich Server Configuration
# ------------------------------------------------------------------------------
# Base URL of your Immich instance (with or without /api, e.g., http://192.168.1.100:2283)
IMMICH_INSTANCE_URL="http://homelab.local:2283"

# Immich API key generated from Immich Web UI -> Account Settings -> API Keys
IMMICH_API_KEY="your_immich_api_key_here"

# Target album name in Immich for categorizing photos (created automatically if missing)
IMMICH_ALBUM_NAME="Life Museum"

# Device identifier reported to Immich
IMMICH_DEVICE_ID="homelab-camera"

# ------------------------------------------------------------------------------
# 2. Camera Configuration
# ------------------------------------------------------------------------------
# Camera connection type:
#   usb    - USB webcam / V4L2 device node (default)
#   rtsp   - IP camera via RTSP stream
#   http   - IP camera or snapshot URL via HTTP/HTTPS
#   rpi    - Raspberry Pi Camera Module (rpicam-still / libcamera-still)
#   custom - Use a custom shell capture command defined in CAMERA_CUSTOM_CMD
CAMERA_TYPE="usb"

# Device path for USB webcam (used when CAMERA_TYPE="usb")
CAMERA_DEVICE="/dev/video0"

# Resolution for camera capture (e.g. 1920x1080, 1280x720)
CAMERA_RESOLUTION="1920x1080"

# Seconds to allow sensor exposure and white balance to settle (prevents dark frames)
CAMERA_WARMUP_SECONDS="2"

# Stream or snapshot URL (used when CAMERA_TYPE="rtsp" or "http")
# Example RTSP: rtsp://username:password@192.168.1.50:554/stream1
# Example HTTP: http://192.168.1.50/cgi-bin/snapshot.cgi
CAMERA_STREAM_URL=""

# Custom capture command (used when CAMERA_TYPE="custom")
# Use {output} as placeholder for destination image path
# Example: ffmpeg -y -f v4l2 -i /dev/video0 -vframes 1 "{output}"
CAMERA_CUSTOM_CMD=""

# ------------------------------------------------------------------------------
# 3. Schedule Configuration
# ------------------------------------------------------------------------------
# Scheduling mode:
#   random_daily    - Captures at a randomized time once per day between WINDOW hours (default)
#   random_hourly   - Captures at a randomized minute once every hour
#   random_interval - Captures repeatedly after a random delay between MIN and MAX intervals
SCHEDULE_MODE="random_daily"

# Active hour window for random_daily mode (24-hour format 00-23)
# Photos will only be snapped during these hours (e.g., 08:00 to 22:00)
WINDOW_START_HOUR="8"
WINDOW_END_HOUR="22"

# Interval boundaries in minutes (used only when SCHEDULE_MODE="random_interval")
MIN_INTERVAL_MINUTES="60"
MAX_INTERVAL_MINUTES="240"

# ------------------------------------------------------------------------------
# 4. Storage & Retention
# ------------------------------------------------------------------------------
# Directory where captured photos are temporarily or permanently saved locally
# (Relative to script directory or absolute path)
STORAGE_DIR="./captures"

# Retention policy for local files:
# Number of days to keep local copies before cleanup (0 = keep forever, never purge)
KEEP_LOCAL_DAYS="30"

# Optional log file location (leave empty to log to stdout/systemd journal)
LOG_FILE=""
